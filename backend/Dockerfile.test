FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app
# API tests do not require OCR executables. The runtime backend image still installs
# Poppler and Tesseract for local PDF and image extraction.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt
COPY app ./app
COPY alembic ./alembic
COPY tests ./tests
COPY alembic.ini .
CMD ["sh", "-c", "alembic upgrade head && pytest -q"]
