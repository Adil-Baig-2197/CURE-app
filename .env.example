# Compose and database
POSTGRES_DB=cure
POSTGRES_USER=cure
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://cure:change-me-for-local-development@db:5432/cure

# Backend
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REPORT_STORAGE_PATH=/app/storage/reports
MAX_REPORT_UPLOAD_BYTES=10485760

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional one-time development administrator bootstrap (do not use production credentials)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
